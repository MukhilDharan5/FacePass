[Unit]
Description=FacePass local face authentication broker
After=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=/opt/facepass-auth/current/venv/bin/python -I -m facepass.auth_service
Restart=on-failure
RestartSec=2
RuntimeDirectory=facepass
RuntimeDirectoryMode=0755
UMask=0077
User=root
Group=root
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MPLCONFIGDIR=/run/facepass/mpl
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/facepass
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=char-video4linux rw
LimitCORE=0
TasksMax=96
MemoryMax=1200M
TimeoutStopSec=4
KillMode=control-group

[Install]
WantedBy=multi-user.target
